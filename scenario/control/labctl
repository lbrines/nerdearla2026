#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
COMPOSE_FILE="$REPO_ROOT/scenario/compose.yaml"
VERSIONS_FILE="$REPO_ROOT/versions.env"
LABFAULT="$REPO_ROOT/scenario/fault/control/labfault"
COMPOSE_PROJECT_NAME="nerdearla2026"
HEALTH_TIMEOUT_SECONDS=60

compose() {
  docker compose --env-file "$VERSIONS_FILE" --project-name "$COMPOSE_PROJECT_NAME" --file "$COMPOSE_FILE" "$@"
}

fail() {
  printf 'labctl: %s\n' "$1" >&2
  return 1
}

wait_for_200() {
  local name="$1"
  local url="$2"
  local deadline="$3"
  local status

  while :; do
    if status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 2 "$url")" && [ "$status" = 200 ]; then
      return 0
    fi
    if (( SECONDS >= deadline )); then
      fail "$name no devolvió HTTP 200 en $url en ${HEALTH_TIMEOUT_SECONDS} segundos (último estado: ${status:-no disponible})"
      return 1
    fi
    sleep 1
  done
}

expect_status() {
  local name="$1"
  local expected="$2"
  local request_id="$3"
  local url="$4"
  local status

  if ! status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 2 \
    -H "X-Request-ID: $request_id" "$url")"; then
    fail "Falló la solicitud a $name"
    return 1
  fi
  if [ "$status" != "$expected" ]; then
    fail "$name devolvió $status; se esperaba $expected"
    return 1
  fi
}

neutral_proxy_present() {
  local proxy_list

  proxy_list="$(compose exec --no-TTY toxiproxy /toxiproxy-cli list 2>/dev/null)" || return 1
  printf '%s\n' "$proxy_list" | awk '
    BEGIN { valid = 1 }
    NF {
      rows++
      if (NF != 5 || $1 != "pricing" || ($2 != "0.0.0.0:8666" && $2 != "[::]:8666") || $3 != "pricing-api:8080" || $4 != "enabled" || $5 != 0) valid = 0
    }
    END { exit !(rows == 1 && valid) }
  '
}

wait_for_neutral_proxy() {
  local deadline="$1"

  while ! neutral_proxy_present; do
    if (( SECONDS >= deadline )); then
      fail 'toxiproxy debe exponer exactamente un proxy pricing habilitado en el puerto comodín 8666, con upstream pricing-api:8080 y cero toxics en un plazo de 60 segundos'
      return 1
    fi
    sleep 1
  done
}

healthy_check() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS))

  wait_for_200 pricing-api http://127.0.0.1:18080/healthz "$deadline"
  wait_for_200 checkout-1 http://127.0.0.1:18081/healthz "$deadline"
  wait_for_200 checkout-2 http://127.0.0.1:18082/healthz "$deadline"
  wait_for_200 checkout-3 http://127.0.0.1:18083/healthz "$deadline"
  wait_for_200 checkout-gateway http://127.0.0.1:18084/healthz "$deadline"
  wait_for_200 checkout-1 http://127.0.0.1:18081/checkout "$deadline"
  wait_for_200 checkout-2 http://127.0.0.1:18082/checkout "$deadline"
  wait_for_200 checkout-3 http://127.0.0.1:18083/checkout "$deadline"
  wait_for_200 checkout-gateway http://127.0.0.1:18084/checkout "$deadline"
  wait_for_neutral_proxy "$deadline"
}

verify_timeout_debug() {
  local request_id="$1"
  local response elapsed_ms

  if ! response="$(curl --silent --show-error --fail --max-time 2 \
    -H "X-Request-ID: $request_id" http://127.0.0.1:18083/debug/upstream)"; then
    fail 'Falló la solicitud de depuración de upstream de checkout-3'
    return 1
  fi
  case "$response" in
    *'"outcome":"timeout"'*) ;;
    *)
      fail "El outcome de depuración de checkout-3 no es timeout: $response"
      return 1
      ;;
  esac
  elapsed_ms="$(printf '%s\n' "$response" | awk -F'"elapsed_ms":' 'NF == 2 { print $2 }' | tr -d '}[:space:]')"
  if ! [[ "$elapsed_ms" =~ ^[0-9]+$ ]] || [ "$elapsed_ms" -lt 480 ]; then
    fail "elapsed_ms de depuración de checkout-3 es ${elapsed_ms:-faltante}; se esperaba al menos 480"
    return 1
  fi
}

verify_degraded_direct() {
  expect_status checkout-3 504 control-probe-01 http://127.0.0.1:18083/checkout
  verify_timeout_debug control-probe-02
  expect_status pricing-api 200 control-probe-03 http://127.0.0.1:18080/healthz
}

verify_controlled_window() {
  local state="$1"
  local request status successes=0 timeouts=0

  for ((request = 1; request <= 90; request++)); do
    if ! status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 2 \
      -H "X-Request-ID: control-window-$request" http://127.0.0.1:18084/checkout)"; then
      fail "Falló la solicitud $request al gateway"
      return 1
    fi
    case "$status" in
      200) successes=$((successes + 1)) ;;
      504) timeouts=$((timeouts + 1)) ;;
      *)
        fail "La solicitud $request al gateway devolvió $status; se esperaba 200 o 504"
        return 1
        ;;
    esac
  done

  case "$state" in
    healthy)
      if [ "$successes" -ne 90 ] || [ "$timeouts" -ne 0 ]; then
        fail "Los resultados healthy del gateway fueron 200=$successes 504=$timeouts; se esperaba 200=90 504=0"
        return 1
      fi
      expect_status checkout-1 200 control-probe-11 http://127.0.0.1:18081/checkout || return $?
      expect_status checkout-2 200 control-probe-12 http://127.0.0.1:18082/checkout || return $?
      expect_status checkout-3 200 control-probe-13 http://127.0.0.1:18083/checkout || return $?
      ;;
    degraded)
      if [ "$successes" -ne 60 ] || [ "$timeouts" -ne 30 ]; then
        fail "Los resultados degraded del gateway fueron 200=$successes 504=$timeouts; se esperaba 200=60 504=30"
        return 1
      fi
      expect_status checkout-1 200 control-probe-11 http://127.0.0.1:18081/checkout || return $?
      expect_status checkout-2 200 control-probe-12 http://127.0.0.1:18082/checkout || return $?
      expect_status checkout-3 504 verify-control-probe-01 http://127.0.0.1:18083/checkout || return $?
      verify_timeout_debug verify-control-probe-02 || return $?
      ;;
    *)
      fail "Estado de escenario desconocido: $state"
      return 1
      ;;
  esac
  expect_status pricing-api 200 "control-pricing" http://127.0.0.1:18080/healthz || return $?
}

VERIFY_LOADGEN_STOPPED=0

verify_restore_loadgen() {
  local restoration_status

  if [ "$VERIFY_LOADGEN_STOPPED" -ne 1 ]; then
    return 0
  fi
  VERIFY_LOADGEN_STOPPED=0
  if compose start load-generator; then
    return 0
  else
    restoration_status=$?
  fi
  printf 'labctl: no se pudo restaurar load-generator después de la secuencia controlada de solicitudes\n' >&2
  return "$restoration_status"
}

verify_exit_restore() {
  local primary_status="$1"
  local restoration_status=0

  trap - EXIT INT TERM
  if verify_restore_loadgen; then
    :
  else
    restoration_status=$?
  fi
  if [ "$restoration_status" -ne 0 ]; then
    if [ "$primary_status" -eq 0 ]; then
      printf 'labctl: la verificación se completó, pero falló la restauración de load-generator\n' >&2
      return "$restoration_status"
    fi
    printf 'labctl: la verificación falló; también falló la restauración de load-generator\n' >&2
  fi
  return "$primary_status"
}

verify_interrupted() {
  local signal="$1"
  local signal_status="$2"

  trap - EXIT INT TERM
  if ! verify_restore_loadgen; then
    printf 'labctl: la verificación fue interrumpida por %s; también falló la restauración de load-generator\n' "$signal" >&2
  fi
  exit "$signal_status"
}

verify() {
  local state running_services verification_status=0 restoration_status=0

  VERIFY_LOADGEN_STOPPED=0
  if ! state="$("$LABFAULT" status "$COMPOSE_PROJECT_NAME")"; then
    fail 'No se pudo consultar el estado de la falla'
    return 1
  fi
  case "$state" in
    healthy|degraded) ;;
    *)
      fail "Estado de escenario desconocido: $state"
      return 1
      ;;
  esac
  if ! running_services="$(compose ps --status running --services load-generator)"; then
    fail 'No se pudo inspeccionar el estado de load-generator'
    return 1
  fi
  case "$running_services" in
    load-generator)
      if ! compose stop load-generator; then
        fail 'No se pudo detener load-generator antes de la secuencia controlada de solicitudes'
        return 1
      fi
      VERIFY_LOADGEN_STOPPED=1
      trap 'verify_exit_restore "$?"' EXIT
      trap 'verify_interrupted INT 130' INT
      trap 'verify_interrupted TERM 143' TERM
      ;;
    '') ;;
    *)
      fail "Estado inesperado de load-generator: $running_services"
      return 1
      ;;
  esac

  if verify_controlled_window "$state"; then
    :
  else
    verification_status=$?
  fi
  if verify_restore_loadgen; then
    :
  else
    restoration_status=$?
  fi
  trap - EXIT INT TERM
  if [ "$verification_status" -ne 0 ]; then
    if [ "$restoration_status" -ne 0 ]; then
      printf 'labctl: la verificación falló; también falló la restauración de load-generator\n' >&2
    fi
    return "$verification_status"
  fi
  if [ "$restoration_status" -ne 0 ]; then
    printf 'labctl: la verificación se completó, pero falló la restauración de load-generator\n' >&2
    return "$restoration_status"
  fi
}

start() {
  compose up --build --detach
  healthy_check
}

fault_on() {
  "$LABFAULT" on "$COMPOSE_PROJECT_NAME"
  verify_degraded_direct
  printf '%s\n' 'Escenario de investigación preparado. Continúa con la siguiente observación.'
}

fault_off() {
  "$LABFAULT" off "$COMPOSE_PROJECT_NAME"
  healthy_check
}

stop() {
  compose down --remove-orphans
}

reset() {
  compose down --volumes --remove-orphans
  start
}

phase_3_placeholder() {
  printf 'Marcador de posición de Phase 3: la operación "%s" pertenece a una revisión posterior de Phase 3.\n' "$1" >&2
  return 1
}

if [ "${LABCTL_TEST_MODE:-}" = 1 ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

if [ "$#" -ne 1 ]; then
  printf 'uso: %s <operación>\n' "$0" >&2
  exit 2
fi

case "$1" in
  start) start ;;
  healthy-check) healthy_check ;;
  fault-on) fault_on ;;
  verify) verify ;;
  fault-off) fault_off ;;
  reset) reset ;;
  stop) stop ;;
  record-ready) phase_3_placeholder "$1" ;;
  *)
    printf 'operación desconocida: %s\n' "$1" >&2
    printf 'uso: %s <operación>\n' "$0" >&2
    exit 2
    ;;
esac
